use tensor;

fn show(t: &tensor::Tensor<f32, 2, 2>) {
    for i in 0..t.len() {
        print(t.at(i))
    }
}

fn main() {
    let a1: f32 = 1.0;
    let a2: f32 = 2.0;
    let a3: f32 = 3.0;
    let a4: f32 = 4.0;
    let mut a = tensor::Tensor<f32, 2, 2>::zeros();
    a.set_at(0, a1);
    a.set_at(1, a2);
    a.set_at(2, a3);
    a.set_at(3, a4);

    let b1: f32 = 10.0;
    let b2: f32 = 20.0;
    let b3: f32 = 30.0;
    let b4: f32 = 40.0;
    let mut b = tensor::Tensor<f32, 2, 2>::zeros();
    b.set_at(0, b1);
    b.set_at(1, b2);
    b.set_at(2, b3);
    b.set_at(3, b4);

    show(&(a + b));
    show(&(b - a));
    show(&(a * b));
}
