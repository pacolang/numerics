module tensor;

/// A disagreement between run-time extents. `axis` is the dimension that
/// disagreed, or `-1` when the element count or the number of `Dyn`
/// extents supplied was wrong.
pub struct ShapeError {
    pub axis: i64,
    pub expected: i64,
    pub found: i64,

    pub fn display(&self) -> string {
        let axis = self.axis.display();
        let expected = self.expected.display();
        let found = self.found.display();
        string_concat(&"shape mismatch at axis ", &string_concat(&axis, &string_concat(&": expected extent ", &string_concat(&expected, &string_concat(&", found ", &found)))))
    }
}

pub fn dims0() -> []i64 {
    slice_of_zeros<i64>(0)
}

pub fn dims1(a: i64) -> []i64 {
    let mut out = slice_of_zeros<i64>(1);
    out[0] = a;
    out
}

pub fn dims2(a: i64, b: i64) -> []i64 {
    let mut out = slice_of_zeros<i64>(2);
    out[0] = a;
    out[1] = b;
    out
}

pub fn dims3(a: i64, b: i64, c: i64) -> []i64 {
    let mut out = slice_of_zeros<i64>(3);
    out[0] = a;
    out[1] = b;
    out[2] = c;
    out
}

/// How many positions of a static shape are `Dyn` (read as `-1`).
pub fn dyn_count(dims: &[]i64) -> i64 {
    let mut count = 0;
    for i in 0..dims.len() {
        if dims[i] < 0 {
            count = count + 1
        }
    }
    count
}

/// The full shape: each `Dyn` position takes the next run-time extent.
pub fn full_shape(dims: &[]i64, dyn_dims: &[]i64) -> []i64 {
    let mut out = slice_of_zeros<i64>(dims.len());
    let mut next = 0;
    for i in 0..dims.len() {
        if dims[i] < 0 {
            out[i] = dyn_dims[next];
            next = next + 1
        } else {
            out[i] = dims[i]
        }
    }
    out
}

pub fn copy_dims(dims: &[]i64) -> []i64 {
    let mut out = slice_of_zeros<i64>(dims.len());
    for i in 0..dims.len() {
        out[i] = dims[i]
    }
    out
}

pub fn element_count(shape: &[]i64) -> i64 {
    let mut count = 1;
    for i in 0..shape.len() {
        count = count * shape[i]
    }
    count
}

/// Checks that two full shapes agree, rank first and then axis by axis.
pub fn check_shape(expected: &[]i64, found: &[]i64) -> Result<i64, ShapeError> {
    if expected.len() != found.len() {
        return Result::Err(ShapeError { axis: -1, expected: expected.len(), found: found.len() })
    }
    for i in 0..expected.len() {
        if expected[i] != found[i] {
            return Result::Err(ShapeError { axis: i, expected: expected[i], found: found[i] })
        }
    }
    Result::Ok(0)
}

/// A dense tensor: one owned row-major buffer, plus one run-time extent for
/// each `Dyn` dimension of its type. Static dimensions live only in the type.
pub struct Tensor<T: Numeric, const D: int...> {
    data: []T,
    dyn_dims: []i64,
    type Tangent = Tensor<T, D...>;

    /// All zeros. Every `Dyn` dimension gets extent `0`.
    pub fn zeros() -> Self {
        let dims = D;
        let dyn_dims = slice_of_zeros<i64>(dyn_count(&dims));
        let shape = full_shape(&dims, &dyn_dims);
        Tensor { data: slice_of_zeros<T>(element_count(&shape)), dyn_dims: dyn_dims }
    }

    /// All zeros, with one run-time extent per `Dyn` dimension, in order.
    pub fn zeros_with(dyn_dims: []i64) -> Result<Self, ShapeError> {
        let dims = D;
        let wanted = dyn_count(&dims);
        if dyn_dims.len() != wanted {
            return Result::Err(ShapeError { axis: -1, expected: wanted, found: dyn_dims.len() })
        }
        let shape = full_shape(&dims, &dyn_dims);
        Result::Ok(Tensor { data: slice_of_zeros<T>(element_count(&shape)), dyn_dims: dyn_dims })
    }

    /// Takes ownership of a row-major buffer whose length must match the shape.
    pub fn from_slice(data: []T, dyn_dims: []i64) -> Result<Self, ShapeError> {
        let dims = D;
        let wanted = dyn_count(&dims);
        if dyn_dims.len() != wanted {
            return Result::Err(ShapeError { axis: -1, expected: wanted, found: dyn_dims.len() })
        }
        let shape = full_shape(&dims, &dyn_dims);
        let count = element_count(&shape);
        if data.len() != count {
            return Result::Err(ShapeError { axis: -1, expected: count, found: data.len() })
        }
        Result::Ok(Tensor { data: data, dyn_dims: dyn_dims })
    }

    /// Converts every element with `as`.
    pub fn cast<S: Numeric>(source: &Tensor<S, D...>) -> Self {
        let mut data = slice_of_zeros<T>(source.data.len());
        for i in 0..source.data.len() {
            data[i] = source.data[i] as T
        }
        Tensor { data: data, dyn_dims: copy_dims(&source.dyn_dims) }
    }

    pub fn rank(&self) -> i64 {
        D.len()
    }

    pub fn shape(&self) -> []i64 {
        let dims = D;
        full_shape(&dims, &self.dyn_dims)
    }

    /// `std::dims::Shaped`: the real extent of axis `axis`, whether static
    /// or `Dyn`.
    pub fn extent(&self, axis: i64) -> i64 {
        self.shape()[axis]
    }

    pub fn len(&self) -> i64 {
        self.data.len()
    }

    pub fn dyn_dims(&self) -> &[]i64 {
        &self.dyn_dims
    }

    pub fn data(&self) -> &[]T {
        &self.data
    }

    pub fn data_mut(&mut self) -> &mut []T {
        &mut self.data
    }

    pub fn at(&self, i: i64) -> T {
        self.data[i]
    }

    pub fn set_at(&mut self, i: i64, value: T) {
        self.data[i] = value
    }

    /// The row-major offset of a multi-index.
    pub fn offset(&self, index: &[]i64) -> i64 {
        let shape = self.shape();
        let mut flat = 0;
        for axis in 0..shape.len() {
            flat = flat * shape[axis] + index[axis]
        }
        flat
    }

    pub fn get(&self, index: []i64) -> T {
        self.data[self.offset(&index)]
    }

    pub fn set(&mut self, index: []i64, value: T) {
        let flat = self.offset(&index);
        self.data[flat] = value
    }
}

methods<T: Numeric + Add + Sub + Mul, const D: int...> Tensor<T, D...> {
    /// Element-wise `+`. Panics if the shapes disagree at run time; use
    /// `checked_add` to get a `Result` instead.
    pub fn add(&self, other: &Self) -> Self {
        match self.checked_add(other) {
            Result::Ok(t) => t,
            Result::Err(e) => panic(e.display()),
        }
    }

    /// Element-wise `+` on operands whose shapes are not proved equal; the
    /// shapes are compared at run time.
    pub fn checked_add<const E: int...>(&self, other: &Tensor<T, E...>) -> Result<Self, ShapeError> {
        check_shape(&self.shape(), &other.shape())?;
        let mut out = slice_of_zeros<T>(self.data.len());
        for i in 0..self.data.len() {
            out[i] = self.data[i] + other.data[i]
        }
        Result::Ok(Tensor { data: out, dyn_dims: copy_dims(&self.dyn_dims) })
    }

    /// Element-wise `-`. Panics if the shapes disagree at run time; use
    /// `checked_sub` to get a `Result` instead.
    pub fn sub(&self, other: &Self) -> Self {
        match self.checked_sub(other) {
            Result::Ok(t) => t,
            Result::Err(e) => panic(e.display()),
        }
    }

    /// Element-wise `-` on operands whose shapes are not proved equal; the
    /// shapes are compared at run time.
    pub fn checked_sub<const E: int...>(&self, other: &Tensor<T, E...>) -> Result<Self, ShapeError> {
        check_shape(&self.shape(), &other.shape())?;
        let mut out = slice_of_zeros<T>(self.data.len());
        for i in 0..self.data.len() {
            out[i] = self.data[i] - other.data[i]
        }
        Result::Ok(Tensor { data: out, dyn_dims: copy_dims(&self.dyn_dims) })
    }

    /// Element-wise `*`. Panics if the shapes disagree at run time; use
    /// `checked_mul` to get a `Result` instead.
    pub fn mul(&self, other: &Self) -> Self {
        match self.checked_mul(other) {
            Result::Ok(t) => t,
            Result::Err(e) => panic(e.display()),
        }
    }

    /// Element-wise `*` on operands whose shapes are not proved equal; the
    /// shapes are compared at run time.
    pub fn checked_mul<const E: int...>(&self, other: &Tensor<T, E...>) -> Result<Self, ShapeError> {
        check_shape(&self.shape(), &other.shape())?;
        let mut out = slice_of_zeros<T>(self.data.len());
        for i in 0..self.data.len() {
            out[i] = self.data[i] * other.data[i]
        }
        Result::Ok(Tensor { data: out, dyn_dims: copy_dims(&self.dyn_dims) })
    }

    pub fn scale(&self, k: T) -> Self {
        let mut out = slice_of_zeros<T>(self.data.len());
        for i in 0..self.data.len() {
            out[i] = self.data[i] * k
        }
        Tensor { data: out, dyn_dims: copy_dims(&self.dyn_dims) }
    }

    pub fn sum(&self) -> T {
        let zero = slice_of_zeros<T>(1);
        let mut acc = zero[0];
        for i in 0..self.data.len() {
            acc = acc + self.data[i]
        }
        acc
    }

    /// `std::autodiff::Differentiable`: the tangent of a tensor is a tensor
    /// of the same shape.
    pub fn zero_tangent(&self) -> Tensor<T, D...> {
        Tensor { data: slice_of_zeros<T>(self.data.len()), dyn_dims: copy_dims(&self.dyn_dims) }
    }

    pub fn move_by(&mut self, offset: &Tensor<T, D...>) {
        for i in 0..self.data.len() {
            self.data[i] = self.data[i] + offset.data[i]
        }
    }
}

/// `d(a + b)`: the gradient of each operand is the seed itself, so `b`'s
/// gradient is a fresh copy of `a`'s (built from a moved-in `seed`, since a
/// `Tensor` cannot be read after it is moved).
struct AddPullback<T: Numeric + Add + Sub + Mul, const D: int...> {
    type Seed = Tensor<T, D...>;
    type Gradients = (Tensor<T, D...>, Tensor<T, D...>);

    fn pullback(self, seed: Tensor<T, D...>) -> (Tensor<T, D...>, Tensor<T, D...>) {
        let mut copy = slice_of_zeros<T>(seed.data.len());
        for i in 0..seed.data.len() {
            copy[i] = seed.data[i]
        }
        let other_grad = Tensor { data: copy, dyn_dims: copy_dims(&seed.dyn_dims) };
        (seed, other_grad)
    }
}

#[derivative(of = Tensor::add)]
fn add_derivative<T: Numeric + Add + Sub + Mul, const D: int...>(a: Tensor<T, D...>, other: &Tensor<T, D...>) -> (Tensor<T, D...>, AddPullback<T, D...>) {
    (a.add(other), AddPullback {})
}

/// `d(a - b)`: `a`'s gradient is the seed, `b`'s is the seed negated
/// element-wise.
struct SubPullback<T: Numeric + Add + Sub + Mul, const D: int...> {
    type Seed = Tensor<T, D...>;
    type Gradients = (Tensor<T, D...>, Tensor<T, D...>);

    fn pullback(self, seed: Tensor<T, D...>) -> (Tensor<T, D...>, Tensor<T, D...>) {
        let z = slice_of_zeros<T>(1)[0];
        let mut neg = slice_of_zeros<T>(seed.data.len());
        for i in 0..seed.data.len() {
            neg[i] = z - seed.data[i]
        }
        let neg_t = Tensor { data: neg, dyn_dims: copy_dims(&seed.dyn_dims) };
        (seed, neg_t)
    }
}

#[derivative(of = Tensor::sub)]
fn sub_derivative<T: Numeric + Add + Sub + Mul, const D: int...>(a: Tensor<T, D...>, other: &Tensor<T, D...>) -> (Tensor<T, D...>, SubPullback<T, D...>) {
    (a.sub(other), SubPullback {})
}

/// `d(a * b)` (element-wise): `a`'s gradient is `seed * b`, `b`'s is
/// `seed * a`. Both operands are kept, since the backward pass needs them.
struct MulPullback<T: Numeric + Add + Sub + Mul, const D: int...> {
    a: Tensor<T, D...>,
    b: Tensor<T, D...>,
    type Seed = Tensor<T, D...>;
    type Gradients = (Tensor<T, D...>, Tensor<T, D...>);

    fn pullback(self, seed: Tensor<T, D...>) -> (Tensor<T, D...>, Tensor<T, D...>) {
        let mut grad_a = slice_of_zeros<T>(seed.data.len());
        let mut grad_b = slice_of_zeros<T>(seed.data.len());
        for i in 0..seed.data.len() {
            grad_a[i] = seed.data[i] * self.b.data[i];
            grad_b[i] = seed.data[i] * self.a.data[i]
        }
        (
            Tensor { data: grad_a, dyn_dims: copy_dims(&seed.dyn_dims) },
            Tensor { data: grad_b, dyn_dims: copy_dims(&seed.dyn_dims) },
        )
    }
}

#[derivative(of = Tensor::mul)]
fn mul_derivative<T: Numeric + Add + Sub + Mul, const D: int...>(a: Tensor<T, D...>, other: &Tensor<T, D...>) -> (Tensor<T, D...>, MulPullback<T, D...>) {
    let result = a.mul(other);
    let mut b_copy = slice_of_zeros<T>(other.data.len());
    for i in 0..other.data.len() {
        b_copy[i] = other.data[i]
    }
    (result, MulPullback { a: a, b: Tensor { data: b_copy, dyn_dims: copy_dims(&other.dyn_dims) } })
}

/// `d(scale(a, k))`: the gradient of `a` is the seed scaled by `k`. `k` is a
/// bare generic parameter (`Type::Generic`, not `Type::Float`), so the
/// compiler's `#[derivative]` check never treats it as differentiable at
/// this generic signature — `Gradients` therefore covers `a` alone, with no
/// gradient reported for `k` itself. See docs/spec.md for detail.
struct ScalePullback<T: Numeric + Add + Sub + Mul, const D: int...> {
    k: T,
    type Seed = Tensor<T, D...>;
    type Gradients = Tensor<T, D...>;

    fn pullback(self, seed: Tensor<T, D...>) -> Tensor<T, D...> {
        let mut out = slice_of_zeros<T>(seed.data.len());
        for i in 0..seed.data.len() {
            out[i] = seed.data[i] * self.k
        }
        Tensor { data: out, dyn_dims: copy_dims(&seed.dyn_dims) }
    }
}

#[derivative(of = Tensor::scale)]
fn scale_derivative<T: Numeric + Add + Sub + Mul, const D: int...>(t: Tensor<T, D...>, k: T) -> (Tensor<T, D...>, ScalePullback<T, D...>) {
    let mut out = slice_of_zeros<T>(t.data.len());
    for i in 0..t.data.len() {
        out[i] = t.data[i] * k
    }
    (Tensor { data: out, dyn_dims: copy_dims(&t.dyn_dims) }, ScalePullback { k: k })
}

/// `d(sum(a))`: the gradient contribution is a tensor of `a`'s shape, every
/// element equal to the scalar seed (broadcast).
struct SumPullback<T: Numeric + Add + Sub + Mul, const D: int...> {
    len: i64,
    dyn_dims: []i64,
    type Seed = T;
    type Gradients = Tensor<T, D...>;

    fn pullback(self, seed: T) -> Tensor<T, D...> {
        let z = slice_of_zeros<T>(1)[0];
        let mut data = slice_of_zeros<T>(self.len);
        for i in 0..self.len {
            data[i] = seed + z
        }
        Tensor { data: data, dyn_dims: self.dyn_dims }
    }
}

#[derivative(of = Tensor::sum)]
fn sum_derivative<T: Numeric + Add + Sub + Mul, const D: int...>(t: Tensor<T, D...>) -> (T, SumPullback<T, D...>) {
    let value = t.sum();
    let len = t.data.len();
    let dyn_dims = copy_dims(&t.dyn_dims);
    (value, SumPullback { len: len, dyn_dims: dyn_dims })
}

methods<T: Numeric, const R: int...> Tensor<T, Dyn, R...> {
    /// Stacks two tensors along their leading `Dyn` axis. Their other
    /// extents must agree at run time; a disagreement is an `Err`.
    pub fn concat<const S: int...>(&self, other: &Tensor<T, Dyn, S...>) -> Result<Self, ShapeError> {
        let left = self.shape();
        let right = other.shape();
        if left.len() != right.len() {
            return Result::Err(ShapeError { axis: -1, expected: left.len(), found: right.len() })
        }
        for i in 1..left.len() {
            if left[i] != right[i] {
                return Result::Err(ShapeError { axis: i, expected: left[i], found: right[i] })
            }
        }
        let mut data = slice_of_zeros<T>(self.data.len() + other.data.len());
        for i in 0..self.data.len() {
            data[i] = self.data[i]
        }
        for i in 0..other.data.len() {
            data[self.data.len() + i] = other.data[i]
        }
        let mut dyn_dims = slice_of_zeros<i64>(self.dyn_dims.len());
        for i in 0..self.dyn_dims.len() {
            dyn_dims[i] = self.dyn_dims[i]
        }
        dyn_dims[0] = self.dyn_dims[0] + other.dyn_dims[0];
        Result::Ok(Tensor { data: data, dyn_dims: dyn_dims })
    }
}

methods<T: Numeric + Add + Mul, const M: int, const K: int> Tensor<T, M, K> {
    /// `self` (M×K) times `other` (K×N); the inner dimensions are proved
    /// equal by the type. Panics if a `Dyn` dimension disagrees at run
    /// time; use `checked_matmul` to get a `Result` instead. (Renamed from
    /// the `Result`-returning form `checked_matmul` already fully
    /// subsumes, mirroring `add`/`sub`/`mul`'s own checked/panicking
    /// split — `#[derivative(of = f)]` needs a plain, non-`Result`
    /// return type to differentiate.)
    pub fn matmul<const N: int>(&self, other: &Tensor<T, K, N>) -> Tensor<T, M, N> {
        match self.checked_matmul(other) {
            Result::Ok(t) => t,
            Result::Err(e) => panic(e.display()),
        }
    }

    /// `self` (M×K) times `other` (J×N) where `K` and `J` are not proved
    /// equal; they are compared at run time.
    pub fn checked_matmul<const J: int, const N: int>(&self, other: &Tensor<T, J, N>) -> Result<Tensor<T, M, N>, ShapeError> {
        let left = self.shape();
        let right = other.shape();
        if left[1] != right[0] {
            return Result::Err(ShapeError { axis: 0, expected: left[1], found: right[0] })
        }
        let rows = left[0];
        let inner = left[1];
        let cols = right[1];
        let mut data = slice_of_zeros<T>(rows * cols);
        for r in 0..rows {
            for c in 0..cols {
                let mut acc = data[r * cols + c];
                for k in 0..inner {
                    acc = acc + self.data[r * inner + k] * other.data[k * cols + c]
                }
                data[r * cols + c] = acc
            }
        }
        let mut dyn_dims = slice_of_zeros<i64>(0);
        if M < 0 && N < 0 {
            dyn_dims = dims2(rows, cols)
        } else if M < 0 {
            dyn_dims = dims1(rows)
        } else if N < 0 {
            dyn_dims = dims1(cols)
        }
        Tensor<T, M, N>::from_slice(data, dyn_dims)
    }
}

/// `d(matmul(a, b))`: `grad_a = seed @ b^T`, `grad_b = a^T @ seed`, written
/// as plain loops (no `transpose` method exists on `Tensor` to call — that
/// would need `math::Matrix`, which depends on `tensor`, never the other
/// way). `grad_a`/`grad_b` share `a`/`b`'s own shape, so their `dyn_dims`
/// are simply copied from the kept operands rather than recomputed.
struct MatmulPullback<T: Numeric + Add + Mul, const M: int, const K: int, const N: int> {
    a: Tensor<T, M, K>,
    b: Tensor<T, K, N>,
    type Seed = Tensor<T, M, N>;
    type Gradients = (Tensor<T, M, K>, Tensor<T, K, N>);

    fn pullback(self, seed: Tensor<T, M, N>) -> (Tensor<T, M, K>, Tensor<T, K, N>) {
        let a_shape = self.a.shape();
        let b_shape = self.b.shape();
        let rows = a_shape[0];
        let inner = a_shape[1];
        let cols = b_shape[1];
        let mut grad_a = slice_of_zeros<T>(rows * inner);
        for r in 0..rows {
            for k in 0..inner {
                let mut acc = grad_a[r * inner + k];
                for c in 0..cols {
                    acc = acc + seed.data[r * cols + c] * self.b.data[k * cols + c]
                }
                grad_a[r * inner + k] = acc
            }
        }
        let mut grad_b = slice_of_zeros<T>(inner * cols);
        for k in 0..inner {
            for c in 0..cols {
                let mut acc = grad_b[k * cols + c];
                for r in 0..rows {
                    acc = acc + self.a.data[r * inner + k] * seed.data[r * cols + c]
                }
                grad_b[k * cols + c] = acc
            }
        }
        (
            Tensor<T, M, K> { data: grad_a, dyn_dims: copy_dims(&self.a.dyn_dims) },
            Tensor<T, K, N> { data: grad_b, dyn_dims: copy_dims(&self.b.dyn_dims) },
        )
    }
}

#[derivative(of = Tensor::matmul)]
fn matmul_derivative<T: Numeric + Add + Mul, const M: int, const K: int, const N: int>(a: Tensor<T, M, K>, other: &Tensor<T, K, N>) -> (Tensor<T, M, N>, MatmulPullback<T, M, K, N>) {
    let result = a.matmul(other);
    let mut b_copy = slice_of_zeros<T>(other.data.len());
    for i in 0..other.data.len() {
        b_copy[i] = other.data[i]
    }
    (result, MatmulPullback { a: a, b: Tensor { data: b_copy, dyn_dims: copy_dims(&other.dyn_dims) } })
}
